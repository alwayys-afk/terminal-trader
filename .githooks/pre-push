#!/usr/bin/env bash
# Refuse to push anything that looks like real account data. This is a
# public repo; see Claude.md ("public-repo PII guardrail").
#
# Enable after a fresh clone:   git config core.hooksPath .githooks
# Scan a range by hand:         .githooks/pre-push --scan <rev-range>
# Bypass (only if you're sure): git push --no-verify
# A line containing "pii-ok" is exempt from the content checks.
set -uo pipefail

zero=$(printf "%040d" 0)   # all-zero sha = branch created/deleted

# Private runtime files that must never be committed (basename match).
name_re='^(tax_lots.*|schwab_tokens.*|callback_key.*|\.env(\..*)?|.*\.log|app_prefs.*|.*transactions.*\.csv)$'
# Dollar amounts of four figures or more, with or without commas (pii-ok)
dollar_re='\$[0-9]{1,3}(,[0-9]{3})+|\$[0-9]{4,}'
# 64-hex strings (Schwab encrypted account hashes are this shape).
hex_re='(^|[^0-9A-Za-z])[0-9A-Fa-f]{64}([^0-9A-Za-z]|$)'
# Bare runs of 8+ digits (account numbers), excluding YYYYMMDD dates.
digits_re='(^|[^0-9A-Za-z_.])[0-9]{8,}([^0-9A-Za-z_]|$)'
date_re='(^|[^0-9])(19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])([^0-9]|$)'

problems=()

scan_range() {
  local range=("$@")
  # File names added or renamed in the range.
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    local base=${path##*/}
    [ "$base" = ".env.example" ] && continue
    if [[ $base =~ $name_re ]]; then
      problems+=("private file: $path")
    fi
  done < <(git log --format= --name-only --diff-filter=AR "${range[@]}" | sort -u)

  # Added lines. Skipped: lockfiles (checksums) and the generated Schwab SDKs
  # and their specs (example payloads full of sample numbers).
  local file="" line
  while IFS= read -r line; do
    if [[ $line == "+++ b/"* ]]; then file=${line#+++ b/}; continue; fi
    [[ $line == "+++ "* ]] && continue
    [[ $line == +* ]] || continue
    case "$file" in *.lock|*-spec.json|*.svg|schwab-marketdata/*|schwab-trader/*) continue ;; esac
    line=${line#+}
    [[ $line == *pii-ok* ]] && continue
    if [[ $line =~ $dollar_re ]]; then
      problems+=("dollar amount in $file: ${line:0:120}")
    elif [[ $line =~ $hex_re ]]; then
      problems+=("64-hex string (account hash?) in $file: ${line:0:120}")
    elif [[ $line =~ $digits_re ]]; then
      local m=${BASH_REMATCH[0]}
      if ! [[ $m =~ $date_re ]]; then
        problems+=("8+ digit number (account number?) in $file: ${line:0:120}")
      fi
    fi
  done < <(git log -p --no-color --format= "${range[@]}")
}

if [ "${1:-}" = "--scan" ]; then
  shift
  scan_range "$@"
else
  # Called by git: stdin has "<local ref> <local sha> <remote ref> <remote sha>".
  while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$zero" ] && continue          # deleting a branch
    if [ "$rsha" = "$zero" ]; then
      scan_range "$lsha" --not --remotes        # new branch: what the remote lacks
    else
      scan_range "$rsha..$lsha"
    fi
  done
fi

if [ ${#problems[@]} -gt 0 ]; then
  {
    echo "pre-push: refusing to push. This looks like real account data:"
    printf '  - %s\n' "${problems[@]}" | head -40
    echo
    echo "Remove it from the commits (amend/rebase), or mark a safe line with 'pii-ok'."
    echo "If you are certain it's safe: git push --no-verify"
  } >&2
  exit 1
fi
exit 0
